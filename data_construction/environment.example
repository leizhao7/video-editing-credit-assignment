# Private input/output directory. Default when unset: ./data/private
VIDEO_EDITING_DATA_ROOT=./data/private
# Shared by run_script_queue.py, run_s4_queue.py, and translate_script.py.
# Supported backends: claude (default), codex, opencode (1.x CLI).
VIDEO_EDITING_ANNOTATION_BACKEND=claude
# Optional executable path/name; blank uses the backend name. Do not include flags.
VIDEO_EDITING_ANNOTATION_CLI=
# Required for annotation; use provider/model for OpenCode. No default model.
VIDEO_EDITING_ANNOTATION_MODEL=
# Optional native effort/variant. Blank: Claude queues=max, translation=low;
# Codex/OpenCode use their native default.
VIDEO_EDITING_ANNOTATION_EFFORT=
# Optional total seconds per shot/S4 invocation or CLI check, including active output.
# Leave unset to disable; a blank value is invalid. Does not limit translation.
# VIDEO_EDITING_ANNOTATION_TIMEOUT_S=1800
# Optional Claude-only S4 MCP config; other backends require native MCP config.
VIDEO_EDITING_MCP_CONFIG=
# Bundled adapters default to data_construction/modal; override only when needed.
VIDEO_EDITING_MODAL_DIR=
# Proxy encoder: blank uses h264_videotoolbox on macOS, libx264 elsewhere.
# Set libx264 explicitly for software encoding on macOS.
VIDEO_EDITING_PROXY_ENCODER=
# Required for explicit cloud stages: an existing volume in your own Modal account.
VIDEO_EDITING_MODAL_VOLUME=
# Only used by build_s3.py --export-resolve.
VIDEO_EDITING_RESOLVE_MCP_ROOT=
# LEGACY, disabled by default; these writers are not part of the release.
# Do not set these to reproduce the paper's official scoring.
VIDEO_EDITING_LEGACY_RUBRIC_WRITER_S2=
VIDEO_EDITING_LEGACY_RUBRIC_WRITER_S3=
# Bundled Modal adapters use these neutral app names unless overridden.
VIDEO_EDITING_SHOTS_APP=video-editing-shots
VIDEO_EDITING_TRANSCRIBE_APP=video-editing-transcribe
VIDEO_EDITING_STEMS_APP=video-editing-stems
VIDEO_EDITING_FILM_TRANSCRIBE_APP=video-editing-film-transcribe
# Historical GPU class retained; no GPU is allocated by importing the scripts.
VIDEO_EDITING_PREPROCESS_GPU=A10G
